{
  "name": "click-bot",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @click-bot/web dev",
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @click-bot/db migrate",
    "db:generate": "pnpm --filter @click-bot/db generate",
    "db:seed": "pnpm --filter @click-bot/db seed",
    "db:reset": "docker compose rm -sfv db && docker volume rm -f click-bot_db-data && pnpm db:up && pnpm db:migrate && pnpm db:seed",
    "test:e2e": "pnpm --filter @click-bot/web test:e2e",
    "worker": "pnpm --filter @click-bot/worker start",
    "demo-site": "pnpm --filter @click-bot/worker demo-site"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
