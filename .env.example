# Copy to .env for local development. Never commit .env.

# Local Postgres (docker compose service "db")
POSTGRES_USER=clickbot
POSTGRES_PASSWORD=clickbot
POSTGRES_DB=clickbot
POSTGRES_PORT=5442
DATABASE_URL=postgres://clickbot:clickbot@localhost:5442/clickbot

# Test Postgres (docker compose service "db-test", in-memory)
POSTGRES_TEST_PORT=5443
DATABASE_URL_TEST=postgres://clickbot:clickbot@localhost:5443/clickbot_test

# Worker
MAX_CONCURRENT_BROWSERS=6

# Key for encrypting secrets, proxy credentials and 2FA secrets (32 bytes, base64).
# Create one with: openssl rand -base64 32
SECRETS_KEY=

# Worker: where screenshots of runs are stored (default: data/artifacts in the repo root)
# ARTIFACTS_DIR=

# Web app: its public address, used in invitation links (pnpm auth:invite and Einstellungen → Team)
# APP_URL=http://localhost:3000

# "Im Browser aufnehmen": the worker serves the live browser on LIVE_PORT; the web app sends
# browsers to LIVE_URL (in production wss://<domain>/live through the reverse proxy). Only the
# web app's origin (APP_URL; during development any localhost port) may connect.
# LIVE_PORT=4200
# LIVE_URL=ws://localhost:4200
# LIVE_MAX_SESSIONS=2
